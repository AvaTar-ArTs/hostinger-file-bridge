# Destination Hostinger SSH/SFTP server
HFB_SFTP_HOST=82.29.199.248
HFB_SFTP_PORT=65002
HFB_SFTP_USERNAME=u365102102

# Recommended: private key file mounted into the service.
# Do NOT commit this key.
HFB_SFTP_KEY_PATH=/run/secrets/hostinger_ed25519

# Optional private key passphrase. Prefer a secret manager.
HFB_SFTP_KEY_PASSPHRASE=

# Every remote file operation is jailed beneath this root.
HFB_REMOTE_ROOT=/home/u365102102/domains/avatararts.org/public_html/gpt-export-rename

# Browser upload endpoint base URL after deployment.
# Example: https://files-mcp.avatararts.org
HFB_PUBLIC_BASE_URL=https://files-mcp.example.com

# HMAC key used for short-lived upload tickets.
# Generate with: openssl rand -hex 32
HFB_UPLOAD_SIGNING_SECRET=replace-with-64-random-hex-chars

# Maximum browser/URL upload, default 512 MiB.
HFB_MAX_UPLOAD_BYTES=536870912

# Seconds a browser upload ticket stays valid.
HFB_UPLOAD_TICKET_TTL=900

# Optional known-hosts file. Strongly recommended in production.
# First capture the Hostinger host key yourself and verify its fingerprint.
HFB_KNOWN_HOSTS_PATH=/run/secrets/known_hosts

HFB_LOG_LEVEL=INFO

# Optional comma-separated HTTPS hosts allowed by upload_from_url.
# Leave empty to disable URL ingestion entirely.
HFB_SOURCE_URL_HOSTS=
